# ------------------------------------------------------------
# Formulaire de contact — src/app/api/contact/route.ts
# ------------------------------------------------------------

# Destinataire des messages du formulaire
# (par défaut : la valeur de siteConfig.email, contact@sisbm-ci.com)
CONTACT_TO=contact@sisbm-ci.com

# Serveur SMTP.
# Si SMTP_HOST est vide → mode "log" : les messages sont journalisés
# côté serveur (aucun e-mail envoyé), l'utilisateur voit quand même
# un écran de succès.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Expéditeur affiché des e-mails de notification
SMTP_FROM="Site SISBM CORE <no-reply@sisbm-ci.com>"